@model List<BanVeXemPhim.Models.Ve>
@{
    ViewData["Title"] = "Vé Của Tôi";
}

<div class="container py-4">
    <h1 class="section-title">🎟️ Lịch Sử Đặt Vé</h1>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã vé</th>
                        <th>Phim</th>
                        <th>Rạp - Phòng</th>
                        <th>Ngày chiếu</th>
                        <th>Giờ chiếu</th>
                        <th>Ghế</th>
                        <th>Giá</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ve in Model)
                    {
                        <tr>
                            <td><code>@ve.MaVe</code></td>
                            <td>@ve.SuatChieu?.Phim?.TenPhim</td>
                            <td>
                                @ve.SuatChieu?.PhongChieu?.RapChieu?.TenRap<br />
                                <small class="text-muted">@ve.SuatChieu?.PhongChieu?.TenPhong</small>
                            </td>
                            <td>@ve.SuatChieu?.NgayChieu.ToString("dd/MM/yyyy")</td>
                            <td>@ve.SuatChieu?.GioChieu.ToString(@"hh\:mm")</td>
                            <td><strong>@ve.SoGhe</strong></td>
                            <td class="text-warning">@ve.GiaTien.ToString("N0")</td>
                            <td>@ve.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (ve.TrangThai == "DaDat")
                                {
                                    <span class="badge bg-success">Đã đặt</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã hủy</span>
                                }
                            </td>
                            <td>
                                @if (ve.TrangThai == "DaDat")
                                {
                                    <form method="post" asp-controller="DatVe" asp-action="HuyVe"
                                          onsubmit="return confirm('Bạn chắc chắn muốn hủy vé này?')">
                                        <input type="hidden" name="id" value="@ve.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-times me-1"></i>Hủy
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-ticket-alt fa-4x text-muted mb-3"></i>
            <p class="text-muted mb-3">Bạn chưa có vé nào.</p>
            <a asp-controller="Phim" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-film me-2"></i>Xem phim ngay
            </a>
        </div>
    }
</div>
