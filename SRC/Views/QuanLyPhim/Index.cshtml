@model List<BanVeXemPhim.Models.Phim>
@{
    ViewData["Title"] = "Quản lý Phim";
    ViewBag.AdminActive = "Phim";
}

<div class="container-fluid py-4">
    <div class="row">
        @await Html.PartialAsync("_AdminSidebar")

        <!-- Main -->
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold">🎬 Quản Lý Phim</h2>
                <a asp-action="Them" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Thêm phim mới
                </a>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Tên phim</th>
                                    <th>Thể loại</th>
                                    <th>Thời lượng</th>
                                    <th>Ngày chiếu</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var phim = Model[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <a asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.Id"
                                               class="text-white text-decoration-none fw-bold">
                                                @phim.TenPhim
                                            </a>
                                        </td>
                                        <td><span class="badge-theloai">@phim.TheLoai?.TenTheLoai</span></td>
                                        <td>@phim.ThoiLuong phút</td>
                                        <td>@phim.NgayKhoiChieu.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (phim.TrangThai == "DangChieu")
                                            {
                                                <span class="badge bg-success">Đang chiếu</span>
                                            }
                                            else if (phim.TrangThai == "SapChieu")
                                            {
                                                <span class="badge bg-warning text-dark">Sắp chiếu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Ngừng chiếu</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Sua" asp-route-id="@phim.Id"
                                               class="btn btn-sm btn-outline-warning me-1">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" asp-action="Xoa" class="d-inline"
                                                  onsubmit="return confirm('Xóa phim @phim.TenPhim?')">
                                                <input type="hidden" name="id" value="@phim.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
