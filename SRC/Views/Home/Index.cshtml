@{
    ViewData["Title"] = "Trang Chủ";
    var phimDangChieu = ViewBag.PhimDangChieu as List<BanVeXemPhim.Models.Phim>;
    var phimSapChieu  = ViewBag.PhimSapChieu  as List<BanVeXemPhim.Models.Phim>;
}

<!-- Hero Banner -->
<section class="hero-section">
    <div class="container">
        <h1>🎬 Trương Thành Trung Tiket</h1>
        <p class="mb-4">Đặt vé xem phim trực tuyến - Nhanh chóng &amp; Tiện lợi</p>
        <a asp-controller="Phim" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="fas fa-ticket-alt me-2"></i>Mua vé ngay
        </a>
    </div>
</section>

<div class="container py-5">

    <!-- Phim đang chiếu -->
    <h2 class="section-title">🔥 Phim Đang Chiếu</h2>
    @if (phimDangChieu != null && phimDangChieu.Any())
    {
        <div class="row g-3 mb-5">
            @foreach (var phim in phimDangChieu)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="phim-card">
                        <a asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.Id" class="text-decoration-none">
                            <img src="@phim.HinhAnh"
                                 alt="@phim.TenPhim" loading="lazy" />
                        </a>
                        <div class="phim-card-body">
                            <div class="phim-card-title">@phim.TenPhim</div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge-theloai">@phim.TheLoai?.TenTheLoai</span>
                                <small class="text-muted">@phim.ThoiLuong phút</small>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.Id"
                                   class="btn btn-primary btn-sm w-100">
                                    <i class="fas fa-ticket-alt me-1"></i>Đặt vé
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Chưa có phim đang chiếu.</p>
    }

    <!-- Phim sắp chiếu -->
    @if (phimSapChieu != null && phimSapChieu.Any())
    {
        <h2 class="section-title">⏳ Phim Sắp Chiếu</h2>
        <div class="row g-3">
            @foreach (var phim in phimSapChieu)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="phim-card">
                        <a asp-controller="Phim" asp-action="ChiTiet" asp-route-id="@phim.Id" class="text-decoration-none">
                            <img src="@phim.HinhAnh"
                                 alt="@phim.TenPhim" loading="lazy" />
                        </a>
                        <div class="phim-card-body">
                            <div class="phim-card-title">@phim.TenPhim</div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge-theloai">@phim.TheLoai?.TenTheLoai</span>
                                <span class="badge-trangThai-SapChieu">Sắp chiếu</span>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    Khởi chiếu: @phim.NgayKhoiChieu.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
