@{
    ViewData["Title"] = "Giới Thiệu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <div style="font-size:4rem">🎬</div>
                <h1 class="fw-bold">Về Trương Thành Trung Tiket</h1>
                <p class="text-muted">Hệ thống đặt vé xem phim trực tuyến</p>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">🎯 Giới thiệu</h4>
                    <p>
                        <strong>Trương Thành Trung Tiket</strong> là website bán vé xem phim trực tuyến được xây dựng
                        làm đồ án môn học <em>Lập trình Web với ASP.NET MVC</em>. Ứng dụng cho phép
                        người dùng xem thông tin phim, suất chiếu và đặt vé một cách nhanh chóng.
                    </p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">⚙️ Công nghệ sử dụng</h4>
                    <ul class="mb-0">
                        <li>ASP.NET Core MVC (.NET 8)</li>
                        <li>Entity Framework Core - Code First</li>
                        <li>SQL Server LocalDB</li>
                        <li>Bootstrap 5 + Font Awesome</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">✨ Chức năng chính</h4>
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-danger">👤 Người dùng</h6>
                            <ul>
                                <li>Đăng ký / Đăng nhập</li>
                                <li>Xem danh sách phim, tìm kiếm</li>
                                <li>Xem chi tiết & suất chiếu</li>
                                <li>Đặt vé, chọn ghế</li>
                                <li>Xem lịch sử đặt vé, hủy vé</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-warning">👑 Quản trị viên</h6>
                            <ul>
                                <li>Dashboard thống kê</li>
                                <li>Quản lý phim, thể loại</li>
                                <li>Quản lý suất chiếu</li>
                                <li>Quản lý vé đã đặt</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a asp-controller="Phim" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="fas fa-ticket-alt me-2"></i>Bắt đầu đặt vé
                </a>
            </div>
        </div>
    </div>
</div>
