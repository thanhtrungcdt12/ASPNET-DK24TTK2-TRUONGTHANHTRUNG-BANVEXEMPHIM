@model BanVeXemPhim.Models.KhachHang
@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div style="font-size:4rem">
                            @(Model.VaiTro == "Admin" ? "👑" : "👤")
                        </div>
                        <h3 class="fw-bold mb-0">@Model.HoTen</h3>
                        <span class="badge bg-secondary">@Model.VaiTro</span>
                    </div>

                    <table class="table table-borderless">
                        <tr>
                            <td class="text-muted" style="width:160px">
                                <i class="fas fa-envelope me-2"></i>Email
                            </td>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <td class="text-muted">
                                <i class="fas fa-phone me-2"></i>Số điện thoại
                            </td>
                            <td>@(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">
                                <i class="fas fa-calendar me-2"></i>Ngày tạo
                            </td>
                            <td>@Model.NgayTao.ToString("dd/MM/yyyy")</td>
                        </tr>
                    </table>

                    <hr style="border-color:#333" />

                    <div class="d-grid gap-2">
                        <a asp-controller="DatVe" asp-action="LichSu" class="btn btn-primary">
                            <i class="fas fa-ticket-alt me-2"></i>Xem vé đã đặt
                        </a>
                        <a asp-action="DangXuat" class="btn btn-outline-danger">
                            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
