@model List<BanVeXemPhim.Models.RapChieu>
@{
    ViewData["Title"] = "Quản lý Rạp Chiếu";
    ViewBag.AdminActive = "Rap";
}

<div class="container-fluid py-4">
    <div class="row">
        @await Html.PartialAsync("_AdminSidebar")

        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold">🏢 Quản Lý Rạp Chiếu</h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalThemRap">
                    <i class="fas fa-plus me-1"></i>Thêm rạp
                </button>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="width:60px">#</th>
                                    <th>Tên rạp</th>
                                    <th>Địa chỉ</th>
                                    <th>Số điện thoại</th>
                                    <th style="width:120px">Số phòng</th>
                                    <th style="width:140px">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || !Model.Any())
                                {
                                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có rạp nào</td></tr>
                                }
                                else
                                {
                                    @for (int i = 0; i < Model.Count; i++)
                                    {
                                        var r = Model[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td class="fw-bold">@r.TenRap</td>
                                            <td>@r.DiaChi</td>
                                            <td>@r.SoDienThoai</td>
                                            <td><span class="badge bg-secondary">@r.PhongChieus.Count</span></td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-warning me-1"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalSuaRap-@r.Id">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <form method="post" asp-action="Xoa" class="d-inline"
                                                      onsubmit="return confirm('Xóa rạp @r.TenRap?')">
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Rạp -->
<div class="modal fade" id="modalThemRap" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:#1e1e1e;border:1px solid #333;color:#e5e5e5">
            <div class="modal-header" style="border-color:#333">
                <h5 class="modal-title">➕ Thêm Rạp Chiếu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Them">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên rạp <span class="text-danger">*</span></label>
                        <input type="text" name="TenRap" class="form-control" required
                               placeholder="VD: Lotte Cinema Sư Vạn Hạnh" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <input type="text" name="DiaChi" class="form-control"
                               placeholder="VD: 11 Sư Vạn Hạnh, Q10, TP.HCM" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="SoDienThoai" class="form-control"
                               placeholder="VD: 028 1234 5678" />
                    </div>
                </div>
                <div class="modal-footer" style="border-color:#333">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Rạp (mỗi rạp 1 modal) -->
@if (Model != null)
{
    foreach (var r in Model)
    {
        <div class="modal fade" id="modalSuaRap-@r.Id" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content" style="background:#1e1e1e;border:1px solid #333;color:#e5e5e5">
                    <div class="modal-header" style="border-color:#333">
                        <h5 class="modal-title">✏️ Sửa Rạp Chiếu</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form method="post" asp-action="Sua">
                        <input type="hidden" name="Id" value="@r.Id" />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Tên rạp <span class="text-danger">*</span></label>
                                <input type="text" name="TenRap" class="form-control" required value="@r.TenRap" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Địa chỉ</label>
                                <input type="text" name="DiaChi" class="form-control" value="@r.DiaChi" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Số điện thoại</label>
                                <input type="text" name="SoDienThoai" class="form-control" value="@r.SoDienThoai" />
                            </div>
                        </div>
                        <div class="modal-footer" style="border-color:#333">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
