@model List<BanVeXemPhim.Models.Ve>
@{
    ViewData["Title"] = "Quản lý Vé";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-2 admin-sidebar">
            <h6 class="text-muted px-3 mb-3 text-uppercase small">Quản trị hệ thống</h6>
            <nav class="nav flex-column">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a>
                <a class="nav-link" asp-controller="QuanLyPhim" asp-action="Index"><i class="fas fa-film me-2"></i>Quản lý Phim</a>
                <a class="nav-link" asp-controller="QuanLySuatChieu" asp-action="Index"><i class="fas fa-calendar-alt me-2"></i>Suất Chiếu</a>
                <a class="nav-link" asp-controller="QuanLyTheLoai" asp-action="Index"><i class="fas fa-tags me-2"></i>Thể Loại</a>
                <a class="nav-link active" asp-controller="QuanLyVe" asp-action="Index"><i class="fas fa-ticket-alt me-2"></i>Quản lý Vé</a>
                <hr style="border-color:#333" />
                <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home me-2"></i>Về trang chủ</a>
            </nav>
        </div>
        <div class="col-md-10">
            <h2 class="fw-bold mb-4">🎟️ Danh Sách Vé Đã Bán</h2>
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Mã vé</th>
                                    <th>Khách hàng</th>
                                    <th>Phim</th>
                                    <th>Ngày chiếu</th>
                                    <th>Ghế</th>
                                    <th>Giá</th>
                                    <th>Ngày đặt</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ve in Model)
                                {
                                    <tr>
                                        <td><code>@ve.MaVe</code></td>
                                        <td>@ve.KhachHang?.HoTen</td>
                                        <td>@ve.SuatChieu?.Phim?.TenPhim</td>
                                        <td>@ve.SuatChieu?.NgayChieu.ToString("dd/MM/yyyy")</td>
                                        <td><strong>@ve.SoGhe</strong></td>
                                        <td class="text-warning">@ve.GiaTien.ToString("N0")</td>
                                        <td>@ve.NgayDat.ToString("dd/MM HH:mm")</td>
                                        <td>
                                            @if (ve.TrangThai == "DaDat")
                                            { <span class="badge bg-success">Đã đặt</span> }
                                            else
                                            { <span class="badge bg-secondary">Đã hủy</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
