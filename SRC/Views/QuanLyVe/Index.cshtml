@model List<BanVeXemPhim.Models.Ve>
@{
    ViewData["Title"] = "Quản lý Vé";
    ViewBag.AdminActive = "Ve";
}

<div class="container-fluid py-4">
    <div class="row">
        @await Html.PartialAsync("_AdminSidebar")
        <div class="col-md-10">
            <h2 class="fw-bold mb-4">🎟️ Danh Sách Vé Đã Bán</h2>
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Mã vé</th>
                                    <th>Khách hàng</th>
                                    <th>Phim</th>
                                    <th>Ngày chiếu</th>
                                    <th>Ghế</th>
                                    <th>Giá</th>
                                    <th>Ngày đặt</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ve in Model)
                                {
                                    <tr>
                                        <td><code>@ve.MaVe</code></td>
                                        <td>@ve.KhachHang?.HoTen</td>
                                        <td>@ve.SuatChieu?.Phim?.TenPhim</td>
                                        <td>@ve.SuatChieu?.NgayChieu.ToString("dd/MM/yyyy")</td>
                                        <td><strong>@ve.SoGhe</strong></td>
                                        <td class="text-warning">@ve.GiaTien.ToString("N0")</td>
                                        <td>@ve.NgayDat.ToString("dd/MM HH:mm")</td>
                                        <td>
                                            @if (ve.TrangThai == "DaDat")
                                            { <span class="badge bg-success">Đã đặt</span> }
                                            else
                                            { <span class="badge bg-secondary">Đã hủy</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
