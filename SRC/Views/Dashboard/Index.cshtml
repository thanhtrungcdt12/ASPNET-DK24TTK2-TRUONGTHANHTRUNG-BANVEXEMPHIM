@{
    ViewData["Title"] = "Quản Trị";
    ViewBag.AdminActive = "Dashboard";
}

<div class="container-fluid py-4">
    <div class="row">
        @await Html.PartialAsync("_AdminSidebar")

        <!-- Main -->
        <div class="col-md-10">
            <h2 class="fw-bold mb-4">📊 Dashboard</h2>

            <!-- Thống kê -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon text-primary">🎬</div>
                        <div class="stat-number">@ViewBag.TongPhim</div>
                        <div class="stat-label">Tổng phim</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon">🎟️</div>
                        <div class="stat-number">@ViewBag.TongVe</div>
                        <div class="stat-label">Tổng vé đã bán</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon">👥</div>
                        <div class="stat-number">@ViewBag.TongKhachHang</div>
                        <div class="stat-label">Khách hàng</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon text-warning">💰</div>
                        <div class="stat-number" style="font-size:1.4rem">
                            @(((decimal)ViewBag.DoanhThu).ToString("N0"))
                        </div>
                        <div class="stat-label">Doanh thu (VNĐ)</div>
                    </div>
                </div>
            </div>

            <!-- Vé mới nhất -->
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-history me-2"></i>5 vé đặt gần nhất
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Mã vé</th>
                                    <th>Khách hàng</th>
                                    <th>Phim</th>
                                    <th>Ghế</th>
                                    <th>Giá</th>
                                    <th>Ngày đặt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.VeMoiNhat is List<BanVeXemPhim.Models.Ve> veList)
                                {
                                    foreach (var ve in veList)
                                    {
                                        <tr>
                                            <td><code>@ve.MaVe</code></td>
                                            <td>@ve.KhachHang?.HoTen</td>
                                            <td>@ve.SuatChieu?.Phim?.TenPhim</td>
                                            <td>@ve.SoGhe</td>
                                            <td class="text-warning">@ve.GiaTien.ToString("N0")</td>
                                            <td>@ve.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
